# Copy to .env. Never commit real credentials.

# bedrock (default, AgentCore) | openai (local only; requires MODEL_PROVIDER=openai)
MODEL_PROVIDER=bedrock
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o

AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# Local MCP gateway. After deploy, set this to the AgentCore Gateway URL.
MCP_URL=http://127.0.0.1:8080/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8080

DEFAULT_ACTOR_ID=customer-001

AGENTCORE_MEMORY_ID=
AGENTCORE_GATEWAY_URL=
AGENTCORE_GATEWAY_ARN=

# Set to 1 only when AgentCore Policy ENFORCE is already attached.
AGENTCORE_POLICY_ENFORCE=0

# none | timeout | http_500
FAILURE_MODE=none
