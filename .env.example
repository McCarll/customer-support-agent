# Copy to .env. Never commit real credentials.
# Local and AgentCore Runtime both use the AWS credential chain
# (task role, SSO, or AWS CLI profile). Do not put access keys here.

AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# Local MCP gateway (policy + tools). In AWS this becomes the AgentCore Gateway URL.
MCP_URL=http://127.0.0.1:8080/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8080

# Same actor_id across sessions is required for long-term memory.
DEFAULT_ACTOR_ID=customer-001

# Filled in after `agentcore deploy` / `agentcore add memory`.
AGENTCORE_MEMORY_ID=
AGENTCORE_GATEWAY_ARN=

# Optional: inject failures for observability drills.
# Values: none | timeout | invalid_params | http_500 | llm_loop
FAILURE_MODE=none
