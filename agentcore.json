{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "CustomerSupportAgent",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "CustomerSupportAgent",
    "environment": "production-like"
  },
  "runtimes": [
    {
      "name": "SupportAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/SupportAgent",
      "runtimeVersion": "PYTHON_3_13",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "authorizerType": "AWS_IAM"
    }
  ],
  "memories": [
    {
      "name": "SupportMemory",
      "strategies": ["USER_PREFERENCE", "SEMANTIC", "SUMMARIZATION"]
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "CustomerSupportGateway",
      "protocol": "MCP",
      "authorizerType": "AWS_IAM",
      "runtimes": ["SupportAgent"],
      "targets": [
        {
          "name": "SupportTarget",
          "type": "MCP",
          "description": "Order, customer, and refund tools with Cedar ENFORCE"
        }
      ]
    }
  ],
  "policyEngines": [
    {
      "name": "RefundPolicyEngine",
      "attachToGateways": ["CustomerSupportGateway"],
      "attachMode": "ENFORCE",
      "policies": [
        {
          "name": "RefundLimit",
          "source": "policy/refund.cedar"
        },
        {
          "name": "ReadTools",
          "source": "policy/read_tools.cedar"
        }
      ]
    }
  ],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}
