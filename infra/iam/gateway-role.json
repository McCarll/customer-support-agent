{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeMcpTarget",
      "Effect": "Allow",
      "Action": ["lambda:InvokeFunction"],
      "Resource": "arn:aws:lambda:eu-west-1:*:function:customer-support-mcp-target"
    },
    {
      "Sid": "WriteGatewayLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:eu-west-1:*:log-group:/aws/bedrock-agentcore/*"
    }
  ]
}
